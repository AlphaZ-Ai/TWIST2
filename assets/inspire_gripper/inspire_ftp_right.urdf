<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Inspire FTP Right Gripper URDF
  
  This is a simplified URDF for the Inspire FTP gripper for use with dex-retargeting.
  The Inspire FTP has 6 DOF per hand:
  - Index finger (1 DOF)
  - Middle finger (1 DOF)
  - Ring finger (1 DOF)
  - Pinky finger (1 DOF)
  - Thumb bend (1 DOF)
  - Thumb rotation (1 DOF)
  
  Joint indices match the Inspire FTP hardware order:
  0: pinky, 1: ring, 2: middle, 3: index, 4: thumb_bend, 5: thumb_rotation
-->
<robot name="inspire_ftp_right">
  
  <!-- Base link (wrist mount point) -->
  <link name="R_hand_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.1 0.02"/>
      </geometry>
    </visual>
  </link>
  
  <!-- Palm link -->
  <link name="R_palm">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.1 0.06"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_wrist_joint" type="fixed">
    <parent link="R_hand_base"/>
    <child link="R_palm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <!-- ========== PINKY FINGER (idx 0) ========== -->
  <link name="R_pinky_proximal">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.03"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_pinky_proximal_joint" type="revolute">
    <parent link="R_palm"/>
    <child link="R_pinky_proximal"/>
    <origin xyz="0.035 0.04 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.7" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_pinky_tip">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_pinky_tip_joint" type="fixed">
    <parent link="R_pinky_proximal"/>
    <child link="R_pinky_tip"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
  
  <!-- ========== RING FINGER (idx 1) ========== -->
  <link name="R_ring_proximal">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.04"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_ring_proximal_joint" type="revolute">
    <parent link="R_palm"/>
    <child link="R_ring_proximal"/>
    <origin xyz="0.015 0.04 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.7" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_ring_tip">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_ring_tip_joint" type="fixed">
    <parent link="R_ring_proximal"/>
    <child link="R_ring_tip"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>
  
  <!-- ========== MIDDLE FINGER (idx 2) ========== -->
  <link name="R_middle_proximal">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.05"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_middle_proximal_joint" type="revolute">
    <parent link="R_palm"/>
    <child link="R_middle_proximal"/>
    <origin xyz="-0.005 0.04 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.7" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_middle_tip">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_middle_tip_joint" type="fixed">
    <parent link="R_middle_proximal"/>
    <child link="R_middle_tip"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  
  <!-- ========== INDEX FINGER (idx 3) ========== -->
  <link name="R_index_proximal">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.04"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_index_proximal_joint" type="revolute">
    <parent link="R_palm"/>
    <child link="R_index_proximal"/>
    <origin xyz="-0.025 0.04 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.7" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_index_tip">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_index_tip_joint" type="fixed">
    <parent link="R_index_proximal"/>
    <child link="R_index_tip"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>
  
  <!-- ========== THUMB (idx 4: bend, idx 5: rotation) ========== -->
  <link name="R_thumb_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="R_thumb_proximal_yaw_joint" type="revolute">
    <parent link="R_palm"/>
    <child link="R_thumb_base"/>
    <origin xyz="-0.04 -0.02 0.03" rpy="0 0 0.5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.1" upper="1.3" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_thumb_proximal">
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.03"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_thumb_proximal_pitch_joint" type="revolute">
    <parent link="R_thumb_base"/>
    <child link="R_thumb_proximal"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.5" effort="1" velocity="2"/>
  </joint>
  
  <link name="R_thumb_tip">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.007"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="R_thumb_tip_joint" type="fixed">
    <parent link="R_thumb_proximal"/>
    <child link="R_thumb_tip"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
  
</robot>
